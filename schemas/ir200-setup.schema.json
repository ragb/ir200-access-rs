{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Setup",
  "description": "The currently selected memory. Writing it switches memories.",
  "type": "object",
  "required": [
    "memory_index"
  ],
  "properties": {
    "memory_index": {
      "description": "0–127 = memory 1–128.",
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
