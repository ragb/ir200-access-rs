{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Setup",
  "description": "The currently selected memory. Writing it switches memories.",
  "type": "object",
  "properties": {
    "memory_index": {
      "description": "0–127 = memory 1–128.",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "memory_index"
  ]
}
