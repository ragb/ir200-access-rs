{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgramChangeMap",
  "description": "The map as stored: `memory[i]` is the stored value for PC#`i + 1`.",
  "type": "object",
  "properties": {
    "memory": {
      "description": "Memory number (1–128) for PC#1 … PC#128.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "memory"
  ]
}
