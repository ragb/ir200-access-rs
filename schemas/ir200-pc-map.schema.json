{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProgramChangeMap",
  "description": "The map as stored: `memory[i]` is the stored value for PC#`i + 1`.",
  "type": "object",
  "required": [
    "memory"
  ],
  "properties": {
    "memory": {
      "description": "Memory number (1–128) for PC#1 … PC#128.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      }
    }
  },
  "additionalProperties": false
}
