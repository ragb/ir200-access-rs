{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory",
  "description": "One memory: what the pedal plays.",
  "type": "object",
  "properties": {
    "ambience": {
      "$ref": "#/$defs/Ambience"
    },
    "amp": {
      "$ref": "#/$defs/Amp"
    },
    "cabinet": {
      "$ref": "#/$defs/CabinetCommon"
    },
    "cabinet_a": {
      "$ref": "#/$defs/Cabinet"
    },
    "cabinet_b": {
      "$ref": "#/$defs/Cabinet"
    },
    "ctl1": {
      "$ref": "#/$defs/Switch"
    },
    "ctl2": {
      "$ref": "#/$defs/Switch"
    },
    "eq_a": {
      "$ref": "#/$defs/Eq"
    },
    "eq_b": {
      "$ref": "#/$defs/Eq"
    },
    "eq_link": {
      "description": "EQ A/B LINK: edit both EQs together.",
      "type": "boolean"
    },
    "exp": {
      "$ref": "#/$defs/Expression"
    },
    "fsw_down": {
      "$ref": "#/$defs/Switch"
    },
    "fsw_up": {
      "$ref": "#/$defs/Switch"
    },
    "input_setting": {
      "description": "INPUT SETTING number, 1–10 (used when SYSTEM > INPUT > PREF is MEMORY).",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "name": {
      "description": "Up to 16 printable ASCII characters.",
      "type": "string"
    },
    "noise_suppressor": {
      "$ref": "#/$defs/NoiseSuppressor"
    },
    "send_return": {
      "$ref": "#/$defs/SendReturn"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "amp",
    "noise_suppressor",
    "send_return",
    "cabinet",
    "cabinet_a",
    "cabinet_b",
    "ambience",
    "eq_link",
    "eq_a",
    "eq_b",
    "input_setting",
    "fsw_down",
    "fsw_up",
    "ctl1",
    "ctl2",
    "exp"
  ],
  "$defs": {
    "Ambience": {
      "description": "AMBIENCE.",
      "type": "object",
      "properties": {
        "ambience_type": {
          "$ref": "#/$defs/AmbienceType"
        },
        "level": {
          "description": "Effect level, 0–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/AmbienceMode"
        },
        "time": {
          "description": "Reverb time in tenths of a second, 1–100 (0.1–10.0 s).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "tone": {
          "description": "Tone, -50–+50.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "ambience_type",
        "time",
        "tone",
        "level"
      ]
    },
    "AmbienceMode": {
      "description": "AMBIENCE MODE.",
      "type": "string",
      "enum": [
        "stereo",
        "dual_mono"
      ]
    },
    "AmbienceType": {
      "description": "AMBIENCE TYPE.",
      "type": "string",
      "enum": [
        "thru",
        "room",
        "studio",
        "hall"
      ]
    },
    "Amp": {
      "description": "AMP.",
      "type": "object",
      "properties": {
        "amp_type": {
          "description": "Amp type (0–11, see the `amp_type` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "bass": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "gain": {
          "description": "Gain, 0–120.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "gain_switch": {
          "$ref": "#/$defs/GainSwitch"
        },
        "level": {
          "description": "Level, 0–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "middle": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "solo": {
          "description": "SOLO SW.",
          "type": "boolean"
        },
        "solo_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "treble": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "amp_type",
        "gain",
        "level",
        "bass",
        "middle",
        "treble",
        "gain_switch",
        "solo",
        "solo_level"
      ]
    },
    "Cabinet": {
      "description": "CABINET A or B.",
      "type": "object",
      "properties": {
        "cab_type": {
          "description": "Cab type, 0–336: presets, then USER IR 1–128 from 209 (see the\n`cab_type` catalog).",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "direct_mix": {
          "description": "Direct sound (speaker off), 0–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "mic_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cab_type",
        "mic_level",
        "direct_mix"
      ]
    },
    "CabinetCommon": {
      "description": "CABINET settings shared by A and B.",
      "type": "object",
      "properties": {
        "ab_link": {
          "description": "A/B LINK: edit both cabinets together.",
          "type": "boolean"
        },
        "adjust": {
          "description": "Time lag of cabinet B against A, 0–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "out_mode": {
          "$ref": "#/$defs/CabinetOutMode"
        }
      },
      "additionalProperties": false,
      "required": [
        "ab_link",
        "out_mode",
        "adjust"
      ]
    },
    "CabinetOutMode": {
      "description": "CABINET OUT MODE.",
      "oneOf": [
        {
          "description": "Cabinet A and B mixed together.",
          "type": "string",
          "const": "mono_mix"
        },
        {
          "description": "Cabinet A and B output in stereo.",
          "type": "string",
          "const": "stereo"
        }
      ]
    },
    "Eq": {
      "description": "EQ A or B (memory and global EQ share the layout).",
      "type": "object",
      "properties": {
        "eq_type": {
          "$ref": "#/$defs/EqType"
        },
        "geq_125hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_16khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_1khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_250hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_2khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_31hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_4khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_500hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_63hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_8khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_level": {
          "description": "Graphic level, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_gain": {
          "description": "Parametric high gain, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_mid_freq": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "high_mid_gain": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_mid_q": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "level": {
          "description": "Parametric level, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_gain": {
          "description": "Parametric low gain, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_mid_freq": {
          "description": "0–29, see the `eq_freq` catalog.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "low_mid_gain": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_mid_q": {
          "description": "0–5, see the `eq_q` catalog.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "on": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "on",
        "eq_type",
        "low_gain",
        "high_gain",
        "level",
        "low_mid_freq",
        "low_mid_q",
        "low_mid_gain",
        "high_mid_freq",
        "high_mid_q",
        "high_mid_gain",
        "geq_level",
        "geq_31hz",
        "geq_63hz",
        "geq_125hz",
        "geq_250hz",
        "geq_500hz",
        "geq_1khz",
        "geq_2khz",
        "geq_4khz",
        "geq_8khz",
        "geq_16khz"
      ]
    },
    "EqType": {
      "description": "EQ TYPE.",
      "oneOf": [
        {
          "description": "Four-band parametric.",
          "type": "string",
          "const": "parametric"
        },
        {
          "description": "Ten-band graphic.",
          "type": "string",
          "const": "graphic"
        }
      ]
    },
    "ExpFunction": {
      "description": "EXP PDL FUNCTION.",
      "type": "string",
      "enum": [
        "off",
        "amp_gain",
        "amp_level",
        "amp_solo_level",
        "send_level",
        "return_level"
      ]
    },
    "Expression": {
      "description": "EXP PDL FUNCTION.",
      "type": "object",
      "properties": {
        "amp_gain_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_gain_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_solo_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_solo_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "function": {
          "$ref": "#/$defs/ExpFunction"
        },
        "return_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "return_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "function",
        "amp_gain_min",
        "amp_gain_max",
        "amp_level_min",
        "amp_level_max",
        "amp_solo_level_min",
        "amp_solo_level_max",
        "send_level_min",
        "send_level_max",
        "return_level_min",
        "return_level_max"
      ]
    },
    "GainSwitch": {
      "description": "Amp GAIN SW.",
      "type": "string",
      "enum": [
        "low",
        "middle",
        "high"
      ]
    },
    "NoiseSuppressor": {
      "description": "NOISE SUPPRESSOR.",
      "type": "object",
      "properties": {
        "release": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "threshold": {
          "description": "Threshold, 0 = OFF, 1–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "threshold",
        "release"
      ]
    },
    "SendReturn": {
      "description": "SEND/RETURN.",
      "type": "object",
      "properties": {
        "adjust": {
          "description": "Time lag between the internal sound and the external effect, 0–100.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/SendReturnMode"
        },
        "on": {
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/SendReturnPosition"
        },
        "return_level": {
          "description": "0–200.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_level": {
          "description": "0–200.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "on",
        "mode",
        "send_level",
        "return_level",
        "adjust",
        "position"
      ]
    },
    "SendReturnMode": {
      "description": "SEND/RETURN MODE.",
      "oneOf": [
        {
          "description": "NORMAL MONO RET: in series, mono return.",
          "type": "string",
          "const": "normal_mono_return"
        },
        {
          "description": "NORMAL STEREO RET: in series, stereo return.",
          "type": "string",
          "const": "normal_stereo_return"
        },
        {
          "description": "DIR MIX MONO RET: return mixed with the direct sound, mono return.",
          "type": "string",
          "const": "direct_mix_mono_return"
        },
        {
          "description": "DIR MIX STEREO RET: return mixed with the direct sound, stereo return.",
          "type": "string",
          "const": "direct_mix_stereo_return"
        }
      ]
    },
    "SendReturnPosition": {
      "description": "SEND/RETURN POSITION.",
      "oneOf": [
        {
          "description": "Before CABINET A and B.",
          "type": "string",
          "const": "pre_cabinet"
        },
        {
          "description": "After EQ A and B.",
          "type": "string",
          "const": "post_eq"
        }
      ]
    },
    "Switch": {
      "description": "A footswitch or CTL jack: DOWN/UP FUNCTION, CTL1/CTL2 FUNCTION.",
      "type": "object",
      "properties": {
        "amp_solo": {
          "description": "AMP SOLO function parameter, 0–1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "eq": {
          "description": "EQ function target: 0 = A, 1 = B, 2 = A+B (`switch_eq` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "function": {
          "$ref": "#/$defs/SwitchFunction"
        },
        "memory": {
          "description": "MEMORY function target: 0 = DEC, 1 = INC, 2–129 = memory 1–128\n(`switch_memory` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_return": {
          "description": "SEND/RET function parameter (always 0).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "function",
        "memory",
        "amp_solo",
        "eq",
        "send_return"
      ]
    },
    "SwitchFunction": {
      "description": "Footswitch / CTL FUNCTION.",
      "type": "string",
      "enum": [
        "memory",
        "amp_solo",
        "eq",
        "send_return"
      ]
    }
  }
}
