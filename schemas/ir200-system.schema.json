{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System",
  "description": "Global settings.",
  "type": "object",
  "properties": {
    "control_preferences": {
      "$ref": "#/$defs/ControlPreferences"
    },
    "ctl1": {
      "$ref": "#/$defs/Switch"
    },
    "ctl2": {
      "$ref": "#/$defs/Switch"
    },
    "eq_a": {
      "$ref": "#/$defs/Eq"
    },
    "eq_b": {
      "$ref": "#/$defs/Eq"
    },
    "eq_link": {
      "description": "GLOBAL EQ A/B LINK.",
      "type": "boolean"
    },
    "exp": {
      "$ref": "#/$defs/Expression"
    },
    "fsw_down": {
      "$ref": "#/$defs/Switch"
    },
    "fsw_up": {
      "$ref": "#/$defs/Switch"
    },
    "input": {
      "$ref": "#/$defs/Input"
    },
    "memory_extent": {
      "$ref": "#/$defs/MemoryExtent"
    },
    "midi": {
      "$ref": "#/$defs/Midi"
    },
    "modules": {
      "$ref": "#/$defs/Modules"
    },
    "output_a": {
      "$ref": "#/$defs/OutputType"
    },
    "output_b": {
      "$ref": "#/$defs/OutputType"
    },
    "output_link": {
      "description": "OUTPUT SELECT A/B LINK.",
      "type": "boolean"
    },
    "phones": {
      "$ref": "#/$defs/Phones"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "usb": {
      "$ref": "#/$defs/Usb"
    }
  },
  "additionalProperties": false,
  "required": [
    "modules",
    "phones",
    "eq_link",
    "eq_a",
    "eq_b",
    "output_link",
    "output_a",
    "output_b",
    "memory_extent",
    "usb",
    "midi",
    "preferences",
    "input",
    "control_preferences",
    "fsw_down",
    "fsw_up",
    "ctl1",
    "ctl2",
    "exp"
  ],
  "$defs": {
    "ControlPreferences": {
      "description": "Controller PREF: per-memory or system-wide footswitch, CTL and EXP settings.",
      "type": "object",
      "properties": {
        "ctl1": {
          "$ref": "#/$defs/Preference"
        },
        "ctl2": {
          "$ref": "#/$defs/Preference"
        },
        "exp": {
          "$ref": "#/$defs/Preference"
        },
        "fsw_down": {
          "$ref": "#/$defs/Preference"
        },
        "fsw_up": {
          "$ref": "#/$defs/Preference"
        }
      },
      "additionalProperties": false,
      "required": [
        "fsw_down",
        "fsw_up",
        "ctl1",
        "ctl2",
        "exp"
      ]
    },
    "Eq": {
      "description": "EQ A or B (memory and global EQ share the layout).",
      "type": "object",
      "properties": {
        "eq_type": {
          "$ref": "#/$defs/EqType"
        },
        "geq_125hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_16khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_1khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_250hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_2khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_31hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_4khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_500hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_63hz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_8khz": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "geq_level": {
          "description": "Graphic level, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_gain": {
          "description": "Parametric high gain, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_mid_freq": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "high_mid_gain": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "high_mid_q": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "level": {
          "description": "Parametric level, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_gain": {
          "description": "Parametric low gain, dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_mid_freq": {
          "description": "0–29, see the `eq_freq` catalog.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "low_mid_gain": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "low_mid_q": {
          "description": "0–5, see the `eq_q` catalog.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "on": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "on",
        "eq_type",
        "low_gain",
        "high_gain",
        "level",
        "low_mid_freq",
        "low_mid_q",
        "low_mid_gain",
        "high_mid_freq",
        "high_mid_q",
        "high_mid_gain",
        "geq_level",
        "geq_31hz",
        "geq_63hz",
        "geq_125hz",
        "geq_250hz",
        "geq_500hz",
        "geq_1khz",
        "geq_2khz",
        "geq_4khz",
        "geq_8khz",
        "geq_16khz"
      ]
    },
    "EqType": {
      "description": "EQ TYPE.",
      "oneOf": [
        {
          "description": "Four-band parametric.",
          "type": "string",
          "const": "parametric"
        },
        {
          "description": "Ten-band graphic.",
          "type": "string",
          "const": "graphic"
        }
      ]
    },
    "ExpFunction": {
      "description": "EXP PDL FUNCTION.",
      "type": "string",
      "enum": [
        "off",
        "amp_gain",
        "amp_level",
        "amp_solo_level",
        "send_level",
        "return_level"
      ]
    },
    "Expression": {
      "description": "EXP PDL FUNCTION.",
      "type": "object",
      "properties": {
        "amp_gain_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_gain_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_solo_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "amp_solo_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "function": {
          "$ref": "#/$defs/ExpFunction"
        },
        "return_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "return_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_level_max": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_level_min": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "function",
        "amp_gain_min",
        "amp_gain_max",
        "amp_level_min",
        "amp_level_max",
        "amp_solo_level_min",
        "amp_solo_level_max",
        "send_level_min",
        "send_level_max",
        "return_level_min",
        "return_level_max"
      ]
    },
    "Input": {
      "description": "INPUT: preference and the ten input level settings.",
      "type": "object",
      "properties": {
        "preference": {
          "description": "0 = MEMORY (each memory picks a setting), 1–10 = that setting for\nall memories (`input_pref` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "setting_1": {
          "description": "Input level of each setting, -20–+20 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_10": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_2": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_3": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_4": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_5": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_6": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_7": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_8": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "setting_9": {
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        }
      },
      "additionalProperties": false,
      "required": [
        "preference",
        "setting_1",
        "setting_2",
        "setting_3",
        "setting_4",
        "setting_5",
        "setting_6",
        "setting_7",
        "setting_8",
        "setting_9",
        "setting_10"
      ]
    },
    "MemoryExtent": {
      "description": "MEMORY EXTENT: the range of memories the pedal steps through.",
      "type": "object",
      "properties": {
        "max": {
          "description": "1–128.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "min": {
          "description": "1–128.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "Midi": {
      "description": "MIDI.",
      "type": "object",
      "properties": {
        "cc_amp_gain": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_amp_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_amp_solo": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_amp_solo_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_bypass": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_ctl1": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_ctl2": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_exp": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_memory_down": {
          "description": "CC numbers: 0 = OFF, 1–31 = CC#1–31, 32–63 = CC#64–95\n(`cc_number` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "cc_memory_up": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "midi_thru": {
          "$ref": "#/$defs/MidiThru"
        },
        "rx_cc": {
          "type": "boolean"
        },
        "rx_channel": {
          "description": "1–16, 17 = OFF (`rx_channel` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rx_pc": {
          "type": "boolean"
        },
        "tx_cc": {
          "type": "boolean"
        },
        "tx_channel": {
          "description": "1–16, 17 = Rx, 18 = OFF (`tx_channel` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "tx_pc": {
          "type": "boolean"
        },
        "usb_thru": {
          "$ref": "#/$defs/MidiThru"
        }
      },
      "additionalProperties": false,
      "required": [
        "midi_thru",
        "usb_thru",
        "rx_channel",
        "tx_channel",
        "rx_pc",
        "tx_pc",
        "rx_cc",
        "tx_cc",
        "cc_memory_down",
        "cc_memory_up",
        "cc_amp_gain",
        "cc_amp_level",
        "cc_amp_solo",
        "cc_amp_solo_level",
        "cc_ctl1",
        "cc_ctl2",
        "cc_exp",
        "cc_bypass"
      ]
    },
    "MidiThru": {
      "description": "MIDI THRU / USB THRU: where incoming MIDI is echoed.",
      "type": "string",
      "enum": [
        "off",
        "usb",
        "midi",
        "usb_and_midi"
      ]
    },
    "Modules": {
      "description": "Module on/off: the long-press switches on the AMP, CABINET and AMBIENCE knobs.",
      "type": "object",
      "properties": {
        "ambience": {
          "type": "boolean"
        },
        "amp": {
          "type": "boolean"
        },
        "cabinet": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "amp",
        "cabinet",
        "ambience"
      ]
    },
    "OutputType": {
      "description": "OUTPUT SELECT TYPE: the kind of amp connected to OUTPUT A or B.",
      "type": "string",
      "enum": [
        "line",
        "jc120_return",
        "jc120_input",
        "combo1_return",
        "combo1_input",
        "combo2_return",
        "combo2_input",
        "stack_return",
        "stack_input",
        "bass_amp_with_tweeter",
        "bass_amp"
      ]
    },
    "Phones": {
      "description": "PHONES.",
      "type": "object",
      "properties": {
        "ambience_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "surround": {
          "type": "boolean"
        },
        "volume": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "volume",
        "surround",
        "ambience_level"
      ]
    },
    "Preference": {
      "description": "Where a controller's settings come from (PREF).",
      "oneOf": [
        {
          "description": "Set per memory.",
          "type": "string",
          "const": "memory"
        },
        {
          "description": "Shared by all memories (SYSTEM).",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "Preferences": {
      "description": "Preferences (OTHER and display settings).",
      "type": "object",
      "properties": {
        "auto_off": {
          "type": "boolean"
        },
        "display_cabinet": {
          "description": "Cabinet display, 0–1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "display_mode": {
          "description": "Play screen display mode, 0–1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "exp_pedal_hold": {
          "description": "EXP PDL HOLD: keep the pedal's effect when switching memories.",
          "type": "boolean"
        },
        "lcd_contrast": {
          "description": "1–16.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "panel_lock": {
          "type": "boolean"
        },
        "play_cursor": {
          "description": "Play cursor, 0–1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "auto_off",
        "lcd_contrast",
        "display_mode",
        "panel_lock",
        "display_cabinet",
        "play_cursor",
        "exp_pedal_hold"
      ]
    },
    "Switch": {
      "description": "A footswitch or CTL jack: DOWN/UP FUNCTION, CTL1/CTL2 FUNCTION.",
      "type": "object",
      "properties": {
        "amp_solo": {
          "description": "AMP SOLO function parameter, 0–1.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "eq": {
          "description": "EQ function target: 0 = A, 1 = B, 2 = A+B (`switch_eq` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "function": {
          "$ref": "#/$defs/SwitchFunction"
        },
        "memory": {
          "description": "MEMORY function target: 0 = DEC, 1 = INC, 2–129 = memory 1–128\n(`switch_memory` catalog).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "send_return": {
          "description": "SEND/RET function parameter (always 0).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "function",
        "memory",
        "amp_solo",
        "eq",
        "send_return"
      ]
    },
    "SwitchFunction": {
      "description": "Footswitch / CTL FUNCTION.",
      "type": "string",
      "enum": [
        "memory",
        "amp_solo",
        "eq",
        "send_return"
      ]
    },
    "Usb": {
      "description": "USB.",
      "type": "object",
      "properties": {
        "generic_efx_out_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "generic_loopback": {
          "type": "boolean"
        },
        "generic_loopback_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "generic_mix_in_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/UsbMode"
        },
        "vendor_dry_out_level": {
          "description": "VENDOR DRY OUT level, 0–200.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor_efx_in_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor_efx_out_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor_loopback": {
          "type": "boolean"
        },
        "vendor_loopback_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "vendor_mix_in_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "vendor_dry_out_level",
        "vendor_efx_in_level",
        "vendor_efx_out_level",
        "vendor_mix_in_level",
        "generic_efx_out_level",
        "generic_mix_in_level",
        "vendor_loopback",
        "vendor_loopback_level",
        "generic_loopback",
        "generic_loopback_level"
      ]
    },
    "UsbMode": {
      "description": "USB MODE.",
      "oneOf": [
        {
          "description": "IR-200 driver (Windows, macOS).",
          "type": "string",
          "const": "vendor"
        },
        {
          "description": "Class compliant (iOS).",
          "type": "string",
          "const": "generic"
        }
      ]
    }
  }
}
